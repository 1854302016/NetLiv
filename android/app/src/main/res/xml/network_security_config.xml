<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows plain HTTP (not HTTPS) only to the local dev backend, since it
    doesn't have a TLS certificate. Android blocks cleartext traffic by
    default; without this, video/image loading fails on-device even though
    plain HTTP JSON API calls succeed (Flutter's own HTTP client doesn't
    enforce this the way native video playback does).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
